# Copy this to .env.secrets and fill in values.
# .env.secrets is gitignored — never commit it.
#
# For local dev with prod data (Neon branching):
#   1. Fill in NEON_API_KEY, NEON_PROJECT_ID, NEON_PASSWORD, NEON_ROLE, NEON_DB
#   2. Run: ./scripts/dev-data-setup.sh
#   3. Run: docker compose up
#
# For local dev with empty DB (default):
#   1. Set ADMIN_TOKEN only
#   2. Run: docker compose up

# Required for docker compose up
ADMIN_TOKEN=

# Required for Neon branching (dev data from prod snapshot)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PASSWORD=
NEON_ROLE=graphminton
NEON_DB=graphminton
